\ WINED64.fth — EditForth editor translated from WinEd (wined.F, 2002).
\
\ The text window is the GRAPHICS App Output window. It is resizable
\ while you edit. Keys match EditForth. See WinEd/README.txt.
\
\   FROMLIB FLOAD WinEd/WINED64.fth
\   WINED64
\
\ Command-N/O/S, Command-Shift-S, Command-W/F/G, Command-Shift-F/G,
\ Command-A/C/X/V/Z, Command-/, Command-Shift-B.
\ Control does the same as Command while this window is key.
\ Esc leaves the graphics window.
\
\ Public domain, as the WinEd sources were.

[DEFINED] EMIT-NO-PAUSE [IF] EMIT-NO-PAUSE [THEN]
[DEFINED] EMIT-NO-WRAPPER [IF] EMIT-NO-WRAPPER [THEN]

ONLY FORTH DEFINITIONS
DECIMAL

[UNDEFINED] :CLASS [IF]
FROMLIB FLOAD Classes/classes.fth
[THEN]

: WE-BAD ( -- ) CR ." WINED64 selftest failed" CR ABORT ;
: WE-SAY-OK ( -- ) CR ." wined64-ok " CR ;

ONLY FORTH ALSO GRAPHICS DEFINITIONS
DECIMAL

8 CONSTANT WE-NSLOT
4096 CONSTANT WE-MINBUF
2 CONSTANT WE-TEXT0
320 CONSTANT WE-KMAX
32 CONSTANT WE-KLEN
256 CONSTANT WE-SHIFT
512 CONSTANT WE-CMD
1024 CONSTANT WE-OPT
200 CONSTANT WE-UP
208 CONSTANT WE-DOWN
203 CONSTANT WE-LEFTK
205 CONSTANT WE-RIGHTK
199 CONSTANT WE-HOME
207 CONSTANT WE-ENDK
201 CONSTANT WE-PGUP
209 CONSTANT WE-PGDN
212 CONSTANT WE-FDEL
213 CONSTANT WE-INSK
210 CONSTANT WE-SCRUP
211 CONSTANT WE-SCRDN

\ Per-slot file bodies. ALLOT is not cleared, so zero the cells now.
\ Open allocates max(2 * file size, WE-MINBUF). Edits grow from there.
CREATE WE-PTRS    WE-NSLOT CELLS ALLOT
WE-PTRS WE-NSLOT CELLS 0 FILL
CREATE WE-CAPS    WE-NSLOT CELLS ALLOT
WE-CAPS WE-NSLOT CELLS 0 FILL
CREATE WE-NAMES   256 WE-NSLOT * ALLOT
CREATE WE-LENS    WE-NSLOT CELLS ALLOT
CREATE WE-CURS    WE-NSLOT CELLS ALLOT
CREATE WE-TOPS    WE-NSLOT CELLS ALLOT
CREATE WE-LEFTS   WE-NSLOT CELLS ALLOT
CREATE WE-DIRTS   WE-NSLOT CELLS ALLOT
CREATE WE-SETTLED WE-NSLOT CELLS ALLOT
CREATE WE-ANCHS   WE-NSLOT CELLS ALLOT
CREATE WE-KTAB    WE-KMAX WE-KLEN * ALLOT
CREATE WE-KTMP    WE-KLEN ALLOT
CREATE WE-FIND    80 ALLOT
CREATE WE-REPL    80 ALLOT
CREATE WE-MSG     80 ALLOT
CREATE WE-TOK     32 ALLOT
CREATE WE-UPBUF   256 ALLOT
CREATE WE-COLP    512 ALLOT
CREATE WE-PBUF    256 ALLOT

VARIABLE WE-SLOT
VARIABLE WE-KCNT
VARIABLE WE-UHAS
VARIABLE WE-ULEN
VARIABLE WE-UCUR
VARIABLE WE-UANCH
VARIABLE WE-UDIRT
VARIABLE WE-CLIPN
VARIABLE WE-UPTR
VARIABLE WE-UCAP
VARIABLE WE-CPTR
VARIABLE WE-CCAP
VARIABLE WE-SPTR
VARIABLE WE-SCAP
VARIABLE WE-GN
VARIABLE WE-GA
VARIABLE WE-GC
VARIABLE WE-BROWSE
VARIABLE WE-OVER
VARIABLE WE-FINDON
VARIABLE WE-REPLON
VARIABLE WE-FIELD
VARIABLE WE-MODE          \ 0 edit, 1 help, 2 confirm
VARIABLE WE-AFTER         \ 0 quit editor, 1 close file
VARIABLE WE-DONE
VARIABLE WE-WASDOWN
VARIABLE WE-K
VARIABLE WE-LO
VARIABLE WE-HI
VARIABLE WE-LS
VARIABLE WE-LE
VARIABLE WE-CS
VARIABLE WE-NW
VARIABLE WE-FULL
VARIABLE WE-UN
VARIABLE WE-ANY
VARIABLE WE-MID
VARIABLE WE-LCOLS
VARIABLE WE-LROWS
VARIABLE WE-SEEN
VARIABLE WE-HC
VARIABLE WE-SR
VARIABLE WE-L0
VARIABLE WE-POFF
VARIABLE WE-BCOL
VARIABLE WE-TLEN
VARIABLE WE-TL
VARIABLE WE-TSTART
VARIABLE WE-ACT
VARIABLE WE-ACOL
VARIABLE WE-ADEL
VARIABLE WE-PAIR
VARIABLE WE-PC
VARIABLE WE-PN
VARIABLE WE-PS
VARIABLE WE-FADDR
VARIABLE WE-FLEN
VARIABLE WE-KLO
VARIABLE WE-KHI
VARIABLE WE-MIDN
VARIABLE WE-JA
VARIABLE WE-JB
VARIABLE WE-FID

: WE-VROWS ( -- n ) G-ROWS WE-TEXT0 - 1 MAX ;
: WE-PTR ( -- a ) WE-SLOT @ CELLS WE-PTRS + ;
: WE-CAPA ( -- a ) WE-SLOT @ CELLS WE-CAPS + ;
: WE-BODY ( -- a ) WE-PTR @ ;
: WE-NAME ( -- a ) WE-SLOT @ 256 * WE-NAMES + ;
: WE-LEN ( -- a ) WE-SLOT @ CELLS WE-LENS + ;
: WE-CUR ( -- a ) WE-SLOT @ CELLS WE-CURS + ;
: WE-TOP ( -- a ) WE-SLOT @ CELLS WE-TOPS + ;
: WE-H0 ( -- a ) WE-SLOT @ CELLS WE-LEFTS + ;
: WE-DIRT ( -- a ) WE-SLOT @ CELLS WE-DIRTS + ;
: WE-ANCH ( -- a ) WE-SLOT @ CELLS WE-ANCHS + ;
: WE-AT ( n -- a ) WE-BODY + ;
: WE-EOL? ( c -- f ) DUP 10 = SWAP 13 = OR ;
: WE-UPC ( c -- c ) DUP [CHAR] a >= OVER [CHAR] z <= AND IF 32 - THEN ;

: WE-SETMSG ( a u -- )
  78 MIN DUP WE-MSG C!
  WE-MSG 1+ SWAP CMOVE
;
: WE-CLRMSG ( -- ) 0 WE-MSG C! ;

: WE-LINE-START ( off -- off' )
  DUP 0= IF EXIT THEN
  BEGIN DUP WHILE
    1- DUP WE-AT C@ WE-EOL? IF 1+ EXIT THEN
  REPEAT
;
: WE-NEXT-EOL ( off -- off' )
  BEGIN DUP WE-LEN @ < WHILE
    DUP WE-AT C@ WE-EOL? IF EXIT THEN
    1+
  REPEAT
;
: WE-NEXT-LINE ( off -- off' )
  WE-NEXT-EOL
  DUP WE-LEN @ < IF 1+ THEN
;
: WE-PREV-LINE ( off -- off' )
  WE-LINE-START DUP 0= IF EXIT THEN
  1- WE-LINE-START
;
: WE-LINE-COL ( -- n ) WE-CUR @ DUP WE-LINE-START - ;

\ First block is at least WE-MINBUF. Later blocks at least double.
\ Not re-entrant: WE-GN WE-GA WE-GC are the only scratch.
: WE-FIT ( n -- n' )
  DUP WE-MINBUF < IF DROP WE-MINBUF THEN
;
: WE-GROW ( n ap ac -- f )
  WE-GC !  WE-GA !  WE-GN !
  WE-GN @ 1 < IF -1 EXIT THEN
  WE-GA @ @ 0= IF
    WE-GN @ WE-FIT WE-GN !
    WE-GN @ ALLOCATE IF
      DROP
      S" out of memory" WE-SETMSG
      0 EXIT
    THEN
    WE-GA @ !
    WE-GN @ WE-GC @ !
    -1 EXIT
  THEN
  WE-GN @ WE-GC @ @ <= IF -1 EXIT THEN
  WE-GC @ @ 2*
  DUP 0< IF
    DROP
    S" out of memory" WE-SETMSG
    0 EXIT
  THEN
  WE-GN @ MAX WE-GN !
  WE-GA @ @ WE-GN @ RESIZE IF
    DROP
    S" out of memory" WE-SETMSG
    0 EXIT
  THEN
  WE-GA @ !
  WE-GN @ WE-GC @ !
  -1
;
: WE-NEED ( n -- f ) WE-PTR WE-CAPA WE-GROW ;

: WE-NORMALIZE ( -- )
  WE-LEN @ 0= IF EXIT THEN
  WE-LEN @ WE-SPTR WE-SCAP WE-GROW 0= IF EXIT THEN
  WE-BODY WE-SPTR @ WE-LEN @ CMOVE
  0 WE-LO !  0 WE-NW !
  BEGIN WE-LO @ WE-LEN @ < WHILE
    WE-SPTR @ WE-LO @ + C@
    DUP 13 = IF
      DROP
      WE-LO @ 1+ WE-LEN @ < IF
        WE-SPTR @ WE-LO @ + 1+ C@ 10 = IF
          1 WE-LO +!
        THEN
      THEN
      10 WE-SPTR @ WE-NW @ + C!
      1 WE-LO +!  1 WE-NW +!
    ELSE
      WE-SPTR @ WE-NW @ + C!
      1 WE-LO +!  1 WE-NW +!
    THEN
  REPEAT
  WE-SPTR @ WE-BODY WE-NW @ CMOVE
  WE-NW @ WE-LEN !
;

: WE-HENSURE ( -- )
  WE-LINE-COL WE-HC !
  WE-HC @ WE-H0 @ < IF WE-HC @ WE-H0 ! EXIT THEN
  WE-HC @ WE-H0 @ G-COLS + >= IF
    WE-HC @ G-COLS - 1+ 0 MAX WE-H0 !
  THEN
;
: WE-ENSURE ( -- )
  WE-CUR @ 0 MAX WE-LEN @ MIN WE-CUR !
  WE-CUR @ WE-LINE-START WE-LS !
  WE-LS @ WE-TOP @ U< IF WE-LS @ WE-TOP ! THEN
  0 WE-SEEN !
  WE-TOP @
  WE-VROWS 0 DO
    DUP WE-LS @ = IF -1 WE-SEEN ! LEAVE THEN
    WE-NEXT-LINE
  LOOP DROP
  WE-SEEN @ 0= IF
    WE-LS @
    WE-VROWS 1- 0 MAX 0 DO WE-PREV-LINE LOOP
    WE-TOP !
  THEN
  WE-HENSURE
;

: WE-HAS-SEL? ( -- f )
  WE-ANCH @ 0< IF 0 EXIT THEN
  WE-ANCH @ WE-CUR @ <>
;
: WE-SNAP ( -- f )
  WE-LEN @ WE-ULEN !
  WE-CUR @ WE-UCUR !
  WE-ANCH @ WE-UANCH !
  WE-DIRT @ WE-UDIRT !
  WE-ULEN @ WE-UPTR WE-UCAP WE-GROW 0= IF
    0 WE-UHAS !  0 EXIT
  THEN
  WE-ULEN @ IF WE-BODY WE-UPTR @ WE-ULEN @ CMOVE THEN
  -1 WE-UHAS !
  -1
;
: WE-UNDO-DO ( -- )
  WE-BROWSE @ IF EXIT THEN
  WE-UHAS @ 0= IF EXIT THEN
  WE-ULEN @ WE-NEED 0= IF EXIT THEN
  WE-ULEN @ IF WE-UPTR @ WE-BODY WE-ULEN @ CMOVE THEN
  WE-ULEN @ WE-LEN !
  WE-UCUR @ WE-CUR !
  WE-UANCH @ WE-ANCH !
  WE-UDIRT @ WE-DIRT !
  0 WE-UHAS !
  WE-ENSURE
;

: WE-DEL-SPAN ( lo hi -- )
  2DUP U> IF SWAP THEN
  WE-HI ! WE-LO !
  WE-HI @ WE-LO @ - DUP 0 <= IF DROP EXIT THEN
  WE-BODY WE-HI @ +
  WE-BODY WE-LO @ +
  WE-LEN @ WE-HI @ -
  CMOVE
  WE-CUR @ WE-LO @ < IF
  ELSE
    WE-CUR @ WE-HI @ >= IF
      WE-HI @ WE-LO @ - NEGATE WE-CUR +!
    ELSE
      WE-LO @ WE-CUR !
    THEN
  THEN
  WE-HI @ WE-LO @ - NEGATE WE-LEN +!
  -1 WE-ANCH !
  -1 WE-DIRT !
;
: WE-DEL-SEL ( -- )
  WE-HAS-SEL? 0= IF EXIT THEN
  WE-ANCH @ WE-CUR @ WE-DEL-SPAN
;

: WE-ROOM? ( extra -- f ) WE-LEN @ + WE-NEED ;
: WE-OPEN-GAP ( -- )
  WE-LEN @
  BEGIN DUP WE-CUR @ > WHILE
    1- DUP WE-AT C@ OVER 1+ WE-AT C!
  REPEAT DROP
;
: WE-INS-CH ( c -- )
  WE-BROWSE @ IF DROP EXIT THEN
  WE-PC !
  WE-HAS-SEL? IF 1 ELSE 0 THEN 1 + WE-ROOM? 0= IF EXIT THEN
  WE-SNAP 0= IF EXIT THEN
  WE-HAS-SEL? IF WE-DEL-SEL THEN
  WE-OVER @ WE-CUR @ WE-LEN @ < AND
  WE-CUR @ WE-AT C@ WE-EOL? 0= AND IF
    WE-PC @ WE-CUR @ WE-AT C!
    1 WE-CUR +!
  ELSE
    WE-OPEN-GAP
    WE-PC @ WE-CUR @ WE-AT C!
    1 WE-LEN +!
    1 WE-CUR +!
  THEN
  -1 WE-DIRT !
  WE-CLRMSG
  WE-ENSURE
;
: WE-BS ( -- )
  WE-BROWSE @ IF EXIT THEN
  WE-HAS-SEL? IF WE-SNAP 0= IF EXIT THEN WE-DEL-SEL WE-ENSURE EXIT THEN
  WE-CUR @ 0= IF EXIT THEN
  WE-SNAP 0= IF EXIT THEN
  WE-CUR @ 1- WE-CUR @ WE-DEL-SPAN
  WE-ENSURE
;
: WE-FDEL-DO ( -- )
  WE-BROWSE @ IF EXIT THEN
  WE-HAS-SEL? IF WE-SNAP 0= IF EXIT THEN WE-DEL-SEL WE-ENSURE EXIT THEN
  WE-CUR @ WE-LEN @ >= IF EXIT THEN
  WE-SNAP 0= IF EXIT THEN
  WE-CUR @ DUP 1+ WE-DEL-SPAN
  WE-ENSURE
;
: WE-NL ( -- )
  WE-BROWSE @ IF EXIT THEN
  10 WE-INS-CH
;

: WE-GOTO ( off col -- )
  >R DUP WE-NEXT-EOL OVER - R> MIN + WE-CUR !
;
: WE-LEFT1 ( -- ) WE-CUR @ IF -1 WE-CUR +! THEN ;
: WE-RIGHT1 ( -- ) WE-CUR @ WE-LEN @ < IF 1 WE-CUR +! THEN ;
: WE-UP1 ( -- )
  WE-LINE-COL WE-HC !
  WE-CUR @ WE-LINE-START DUP 0= IF DROP EXIT THEN
  WE-PREV-LINE WE-HC @ WE-GOTO
;
: WE-DOWN1 ( -- )
  WE-LINE-COL WE-HC !
  WE-CUR @ WE-NEXT-LINE
  DUP WE-CUR @ = IF DROP EXIT THEN
  WE-HC @ WE-GOTO
;
: WE-HOME-LINE ( -- ) WE-CUR @ WE-LINE-START WE-CUR ! ;
: WE-END-LINE ( -- ) WE-CUR @ WE-NEXT-EOL WE-CUR ! ;
: WE-DOC-HOME ( -- ) 0 WE-CUR ! ;
: WE-DOC-END ( -- ) WE-LEN @ WE-CUR ! ;
: WE-PAGE ( n -- )
  WE-LINE-COL WE-HC !
  DUP 0< IF
    NEGATE 0 DO WE-TOP @ DUP 0= IF DROP LEAVE THEN WE-PREV-LINE WE-TOP ! LOOP
  ELSE
    0 DO WE-TOP @ WE-NEXT-LINE DUP WE-TOP @ = IF DROP LEAVE THEN
      DUP WE-LEN @ > IF DROP LEAVE THEN WE-TOP !
    LOOP
  THEN
  WE-TOP @ WE-HC @ WE-GOTO
;
: WE-LINE-EMPTY? ( off -- f )
  DUP WE-NEXT-EOL SWAP - 0=
;
: WE-BLANK-PAGE ( dir -- )
  0> IF
    WE-CUR @ WE-NEXT-LINE
    BEGIN DUP WE-LEN @ < WHILE
      DUP WE-LINE-EMPTY? IF WE-NEXT-LINE WE-CUR ! EXIT THEN
      WE-NEXT-LINE
    REPEAT DROP
    WE-DOC-END
  ELSE
    WE-CUR @ WE-LINE-START
    BEGIN DUP WHILE
      WE-PREV-LINE
      DUP WE-LINE-EMPTY? IF WE-CUR ! EXIT THEN
    REPEAT
    WE-CUR !
  THEN
;

: WE-WCH? ( c -- f ) DUP BL > SWAP 127 < AND ;
: WE-WORDL ( -- )
  BEGIN WE-CUR @ 0> WE-CUR @ 1- WE-AT C@ WE-WCH? 0= AND WHILE
    -1 WE-CUR +!
  REPEAT
  BEGIN WE-CUR @ 0> WE-CUR @ 1- WE-AT C@ WE-WCH? AND WHILE
    -1 WE-CUR +!
  REPEAT
;
: WE-WORDR ( -- )
  BEGIN WE-CUR @ WE-LEN @ < WE-CUR @ WE-AT C@ WE-WCH? AND WHILE
    1 WE-CUR +!
  REPEAT
  BEGIN WE-CUR @ WE-LEN @ < WE-CUR @ WE-AT C@ WE-WCH? 0= AND WHILE
    1 WE-CUR +!
  REPEAT
;

: WE-SEL-ALL ( -- ) 0 WE-ANCH !  WE-LEN @ WE-CUR !  WE-ENSURE ;
: WE-SPAN ( -- n )
  WE-HAS-SEL? 0= IF 0 EXIT THEN
  WE-ANCH @ WE-CUR @ 2DUP > IF SWAP THEN -
;
: WE-COPY ( -- f )
  WE-HAS-SEL? 0= IF 0 WE-CLIPN ! -1 EXIT THEN
  WE-ANCH @ WE-CUR @ 2DUP > IF SWAP THEN
  OVER -
  DUP WE-CPTR WE-CCAP WE-GROW 0= IF 2DROP 0 EXIT THEN
  DUP WE-CLIPN !
  0= IF DROP -1 EXIT THEN
  SWAP WE-AT WE-CPTR @ WE-CLIPN @ CMOVE
  -1
;
: WE-CUT ( -- )
  WE-BROWSE @ IF EXIT THEN
  WE-COPY 0= IF EXIT THEN
  WE-HAS-SEL? IF WE-SNAP 0= IF EXIT THEN WE-DEL-SEL WE-ENSURE THEN
;
: WE-PASTE ( -- )
  WE-BROWSE @ IF EXIT THEN
  WE-CLIPN @ 0= IF EXIT THEN
  WE-LEN @ WE-SPAN - WE-CLIPN @ + WE-NEED 0= IF EXIT THEN
  WE-SNAP 0= IF EXIT THEN
  WE-DEL-SEL
  WE-CLIPN @ 0 DO
    WE-OPEN-GAP
    WE-CPTR @ I + C@ WE-CUR @ WE-AT C!
    1 WE-LEN +!
    1 WE-CUR +!
  LOOP
  -1 WE-DIRT !
  WE-ENSURE
;

\ --- comment toggle: leading "\ " , same rule as EditForth -------------

: WE-SCR-C ( c -- )
  WE-NW @ 1+ WE-SPTR WE-SCAP WE-GROW 0= IF
    DROP -1 WE-FULL ! EXIT
  THEN
  WE-SPTR @ WE-NW @ + C!
  1 WE-NW +!
;
: WE-COMM-RANGE ( -- lo hi )
  WE-HAS-SEL? 0= IF
    WE-CUR @ WE-LINE-START DUP WE-NEXT-LINE EXIT
  THEN
  WE-ANCH @ WE-CUR @ 2DUP > IF SWAP THEN
  WE-HI ! WE-LO !
  WE-HI @ WE-LO @ > IF
    WE-HI @ DUP WE-LINE-START <> IF
      WE-HI @ WE-LINE-START WE-NEXT-LINE WE-HI !
    THEN
  THEN
  WE-LO @ WE-LINE-START WE-LO !
  WE-LO @ WE-HI @
;
: WE-COMMENT ( -- )
  WE-BROWSE @ IF EXIT THEN
  WE-COMM-RANGE WE-HI ! WE-LO !
  WE-HI @ WE-LO @ <= IF EXIT THEN
  -1 WE-UN !  0 WE-ANY !
  WE-LO @
  BEGIN DUP WE-HI @ < WHILE
    DUP WE-NEXT-EOL OVER - WE-PN !
    WE-PN @ IF
      -1 WE-ANY !
      WE-PN @ 2 < IF
        0 WE-UN !
      ELSE
        DUP WE-AT C@ [CHAR] \ =
        OVER 1+ WE-AT C@ BL = AND 0= IF
          0 WE-UN !
        THEN
      THEN
    THEN
    WE-NEXT-LINE
  REPEAT DROP
  WE-ANY @ 0= IF 0 WE-UN ! THEN
  0 WE-FULL !  0 WE-NW !
  WE-LO @ WE-SPTR WE-SCAP WE-GROW 0= IF EXIT THEN
  WE-LO @ IF WE-BODY WE-SPTR @ WE-LO @ CMOVE THEN
  WE-LO @ WE-NW !
  WE-LO @
  BEGIN DUP WE-HI @ < WHILE
    DUP WE-LS !
    DUP WE-NEXT-EOL WE-LE !
    DROP
    WE-LS @ WE-CS !
    WE-UN @ IF
      WE-LE @ WE-LS @ - 2 >=
      WE-LS @ WE-AT C@ [CHAR] \ = AND
      WE-LS @ 1+ WE-AT C@ BL = AND IF
        WE-LS @ 2 + WE-CS !
      THEN
    ELSE
      [CHAR] \ WE-SCR-C  BL WE-SCR-C
    THEN
    WE-CS @
    BEGIN DUP WE-LE @ < WHILE
      DUP WE-AT C@ WE-SCR-C 1+
    REPEAT DROP
    WE-LE @ WE-LEN @ < IF
      WE-LE @ WE-AT C@ 10 = IF 10 WE-SCR-C THEN
    THEN
    WE-LS @ WE-NEXT-LINE
  REPEAT DROP
  WE-FULL @ IF EXIT THEN
  WE-NW @ WE-LEN @ WE-HI @ - + WE-SPTR WE-SCAP WE-GROW 0= IF EXIT THEN
  WE-NW @ WE-LEN @ WE-HI @ - + WE-NEED 0= IF EXIT THEN
  WE-SNAP 0= IF EXIT THEN
  WE-NW @ WE-LO @ - WE-MID !
  WE-BODY WE-HI @ +  WE-SPTR @ WE-NW @ +  WE-LEN @ WE-HI @ - CMOVE
  WE-LEN @ WE-HI @ - WE-NW +!
  WE-SPTR @ WE-BODY WE-NW @ CMOVE
  WE-NW @ WE-LEN !
  WE-LO @ WE-ANCH !
  WE-LO @ WE-MID @ + WE-CUR !
  -1 WE-DIRT !
  WE-ENSURE
;

\ --- find / replace ------------------------------------------------------

: WE-CEQ ( c1 c2 -- f ) WE-UPC SWAP WE-UPC = ;
: WE-FIND-AT ( off -- f )
  WE-FIND C@ 0= IF DROP 0 EXIT THEN
  DUP WE-FIND C@ + WE-LEN @ > IF DROP 0 EXIT THEN
  WE-FIND C@ 0 DO
    DUP I + WE-AT C@  WE-FIND 1+ I + C@  WE-CEQ 0= IF
      DROP UNLOOP 0 EXIT
    THEN
  LOOP DROP -1
;
: WE-MARK-HIT ( off -- )
  DUP WE-ANCH !
  WE-FIND C@ + WE-CUR !
  WE-ENSURE
  WE-CLRMSG
;
: WE-FIND-NEXT ( -- )
  WE-FIND C@ 0= IF EXIT THEN
  WE-HAS-SEL? IF
    WE-ANCH @ WE-CUR @ MIN WE-FIND C@ +
  ELSE
    WE-CUR @ 1+
  THEN
  BEGIN DUP WE-LEN @ <= WHILE
    DUP WE-LEN @ = IF DROP S" not found" WE-SETMSG EXIT THEN
    DUP WE-FIND-AT IF WE-MARK-HIT EXIT THEN
    1+
  REPEAT DROP
;
: WE-FIND-PREV ( -- )
  WE-FIND C@ 0= IF EXIT THEN
  -1 WE-LO !
  0
  BEGIN DUP WE-CUR @ < WHILE
    DUP WE-FIND-AT IF WE-LO ! THEN
    1+
  REPEAT DROP
  WE-LO @ 0< IF S" not found" WE-SETMSG EXIT THEN
  WE-LO @ WE-MARK-HIT
;
: WE-SEL-IS-FIND? ( -- f )
  WE-HAS-SEL? 0= IF 0 EXIT THEN
  WE-ANCH @ WE-CUR @ 2DUP > IF SWAP THEN
  OVER - WE-FIND C@ <> IF 2DROP 0 EXIT THEN
  SWAP WE-FIND-AT NIP
;
: WE-REPLACE-ONE ( -- )
  WE-BROWSE @ IF EXIT THEN
  WE-SEL-IS-FIND? 0= IF WE-FIND-NEXT EXIT THEN
  WE-REPL C@ WE-LEN @ WE-FIND C@ - + WE-NEED 0= IF EXIT THEN
  WE-SNAP 0= IF EXIT THEN
  WE-DEL-SEL
  WE-REPL C@ 0 DO
    WE-OPEN-GAP
    WE-REPL 1+ I + C@ WE-CUR @ WE-AT C!
    1 WE-LEN +!
    1 WE-CUR +!
  LOOP
  -1 WE-DIRT !
  WE-FIND-NEXT
;

: WE-FIELD-BS ( -- )
  WE-FIELD @ IF WE-REPL ELSE WE-FIND THEN
  DUP C@ DUP IF 1- SWAP C! ELSE DROP DROP THEN
;
: WE-FIELD-CH ( c -- )
  WE-FIELD @ IF WE-REPL ELSE WE-FIND THEN
  DUP C@ 64 < IF
    DUP C@ 1+ OVER C!
    DUP C@ + C!
  ELSE
    DROP DROP
  THEN
;
: WE-FIND-OPEN ( -- ) -1 WE-FINDON !  0 WE-REPLON !  0 WE-FIELD ! ;
: WE-FIND-REPL ( -- ) -1 WE-FINDON !  -1 WE-REPLON !  0 WE-FIELD ! ;
: WE-SETFIND ( a u -- )
  64 MIN DUP WE-FIND C!
  WE-FIND 1+ SWAP CMOVE
;

\ --- files ---------------------------------------------------------------

: WE-FREE-N ( n -- )
  DUP CELLS WE-PTRS + >R
  R@ @ ?DUP IF FREE DROP 0 R@ ! THEN
  R> DROP
  CELLS WE-CAPS + 0 SWAP !
;
: WE-CLEAR-N ( n -- )
  DUP WE-FREE-N
  DUP CELLS WE-LENS + 0 SWAP !
  DUP CELLS WE-CURS + 0 SWAP !
  DUP CELLS WE-TOPS + 0 SWAP !
  DUP CELLS WE-LEFTS + 0 SWAP !
  DUP CELLS WE-DIRTS + 0 SWAP !
  DUP CELLS WE-ANCHS + -1 SWAP !
  256 * WE-NAMES + 0 SWAP C!
;
: WE-BOOT ( -- )
  WE-NSLOT 0 DO I WE-CLEAR-N LOOP
  0 WE-SLOT !  0 WE-UHAS !  0 WE-CLIPN !
  0 WE-BROWSE !  0 WE-OVER !  0 WE-FINDON !  0 WE-REPLON !
  0 WE-MODE !  0 WE-DONE !  0 WE-FIND C!  0 WE-REPL C!  0 WE-MSG C!
  WE-SETTLED WE-NSLOT CELLS 0 FILL
;
: WE-EMPTY? ( -- f ) WE-LEN @ 0= WE-NAME C@ 0= AND ;
: WE-USE-SLOT ( -- )
  WE-EMPTY? IF EXIT THEN
  WE-NSLOT 0 DO
    I CELLS WE-LENS + @ 0=
    I 256 * WE-NAMES + C@ 0= AND IF
      I WE-SLOT ! UNLOOP EXIT
    THEN
  LOOP
  S" no free file" WE-SETMSG
;
: WE-SETNAME ( a u -- )
  255 MIN DUP WE-NAME C!
  WE-NAME 1+ SWAP CMOVE
;
: WE-READ ( a u -- )
  R/O OPEN-FILE IF DROP S" unreadable" WE-SETMSG EXIT THEN
  WE-FID !
  WE-FID @ FILE-SIZE IF
    2DROP WE-FID @ CLOSE-FILE DROP S" unreadable" WE-SETMSG EXIT
  THEN
  ?DUP IF
    2DROP WE-FID @ CLOSE-FILE DROP S" too big" WE-SETMSG EXIT
  THEN
  DUP 0< IF
    DROP WE-FID @ CLOSE-FILE DROP S" too big" WE-SETMSG EXIT
  THEN
  DUP 2*
  DUP 0< IF
    2DROP WE-FID @ CLOSE-FILE DROP S" too big" WE-SETMSG EXIT
  THEN
  DUP WE-MINBUF < IF DROP WE-MINBUF THEN
  WE-SLOT @ WE-FREE-N
  DUP ALLOCATE IF
    DROP DROP DROP
    WE-FID @ CLOSE-FILE DROP
    S" out of memory" WE-SETMSG EXIT
  THEN
  WE-PTR !
  WE-CAPA !
  WE-BODY SWAP WE-FID @ READ-FILE
  WE-FID @ CLOSE-FILE DROP
  IF
    DROP
    WE-SLOT @ WE-FREE-N
    S" unreadable" WE-SETMSG EXIT
  THEN
  WE-CLRMSG
  WE-LEN !
  WE-NORMALIZE
  0 WE-CUR !  0 WE-TOP !  0 WE-H0 !  -1 WE-ANCH !
  0 WE-DIRT !  0 WE-UHAS !
  WE-ENSURE
;
: WE-WRITE ( -- f )
  WE-NAME C@ 0= IF 0 EXIT THEN
  WE-NAME COUNT W/O CREATE-FILE IF DROP 0 EXIT THEN
  WE-FID !
  WE-BODY WE-LEN @ WE-FID @ WRITE-FILE
  WE-FID @ CLOSE-FILE DROP
  IF 0 EXIT THEN
  0 WE-DIRT !  -1
;
: WE-TAKE-PATH ( -- f )
  WE-PBUF 1+ 250 (APP-FILE-PATH) DUP IF
    WE-PBUF C!  WE-PBUF COUNT WE-SETNAME -1
  ELSE
    DROP 0
  THEN
;
: WE-DO-NEW ( -- )
  WE-USE-SLOT
  WE-EMPTY? IF WE-CLRMSG THEN
;
: WE-DO-OPEN ( -- )
  WE-USE-SLOT
  (APP-FILE-CHOOSE) IF EXIT THEN
  WE-TAKE-PATH 0= IF EXIT THEN
  WE-NAME COUNT WE-READ
;
: WE-DO-SAVEAS ( -- )
  (APP-FILE-SAVE-AS) IF EXIT THEN
  WE-TAKE-PATH 0= IF EXIT THEN
  WE-WRITE 0= IF S" save failed" WE-SETMSG THEN
;
: WE-DO-SAVE ( -- )
  WE-NAME C@ 0= IF WE-DO-SAVEAS EXIT THEN
  WE-WRITE 0= IF S" save failed" WE-SETMSG THEN
;
\ Next dirty slot this quit has not already saved or discarded.
: WE-OTHER-DIRTY ( -- f )
  WE-NSLOT 1 DO
    WE-SLOT @ I + WE-NSLOT MOD
    DUP CELLS WE-DIRTS + @
    OVER CELLS WE-SETTLED + @ 0= AND IF
      WE-SLOT !
      0 WE-UHAS !
      WE-ENSURE
      -1 UNLOOP EXIT
    ELSE
      DROP
    THEN
  LOOP
  0
;
\ Close clears this slot. Quit remembers the answer and asks the next.
: WE-RESOLVED ( -- )
  WE-AFTER @ IF
    WE-SLOT @ WE-CLEAR-N
    0 WE-MODE !
  ELSE
    -1 WE-SLOT @ CELLS WE-SETTLED + !
    WE-OTHER-DIRTY IF
      2 WE-MODE !
    ELSE
      0 WE-MODE !
      -1 WE-DONE !
    THEN
  THEN
;
: WE-ASK ( after -- )
  WE-AFTER !
  WE-DIRT @ IF 2 WE-MODE ! EXIT THEN
  WE-AFTER @ IF WE-SLOT @ WE-CLEAR-N EXIT THEN
  WE-OTHER-DIRTY IF 2 WE-MODE ! ELSE -1 WE-DONE ! THEN
;
: WE-DO-CLOSE ( -- ) 1 WE-ASK ;
: WE-ASK-QUIT ( -- )
  WE-SETTLED WE-NSLOT CELLS 0 FILL
  0 WE-ASK
;
: WE-CONFIRM-KEY ( c -- )
  DUP [CHAR] s = OVER [CHAR] S = OR IF
    DROP WE-DO-SAVE
    WE-DIRT @ 0= IF WE-RESOLVED THEN
    EXIT
  THEN
  DUP [CHAR] d = OVER [CHAR] D = OR IF
    DROP WE-RESOLVED
    EXIT
  THEN
  27 = IF
    WE-AFTER @ 0= IF WE-SETTLED WE-NSLOT CELLS 0 FILL THEN
    0 WE-MODE !
  THEN
;
: WE-NEXT-FILE ( -- )
  WE-SLOT @ 1+ WE-NSLOT MOD WE-SLOT !
  0 WE-UHAS !
  WE-ENSURE
;

\ --- keywords from WINED.COL ---------------------------------------------

: WE-KREC ( n -- a ) WE-KLEN * WE-KTAB + ;
: WE-KCMP ( i j -- n )
  WE-KREC WE-JB !
  WE-KREC WE-JA !
  WE-JA @ C@ WE-JB @ C@ MIN 0 DO
    WE-JA @ 3 + I + C@
    WE-JB @ 3 + I + C@
    - DUP IF UNLOOP EXIT THEN DROP
  LOOP
  WE-JA @ C@ WE-JB @ C@ -
;
: WE-KSWAP ( i j -- )
  WE-KREC WE-JB !
  WE-KREC WE-JA !
  WE-JA @ WE-KTMP WE-KLEN CMOVE
  WE-JB @ WE-JA @ WE-KLEN CMOVE
  WE-KTMP WE-JB @ WE-KLEN CMOVE
;
: WE-KSORT ( -- )
  WE-KCNT @ 1 ?DO
    I
    BEGIN DUP 0> WHILE
      DUP 1- OVER WE-KCMP 0> IF
        DUP DUP 1- WE-KSWAP 1-
      ELSE
        DROP 0
      THEN
    REPEAT DROP
  LOOP
;
: WE-SKIP ( a u -- a u )
  BEGIN DUP WHILE OVER C@ BL = WHILE 1 /STRING REPEAT THEN
;
: WE-NUM ( a u -- a u n )
  0 >R
  BEGIN DUP WHILE OVER C@ [CHAR] 0 [CHAR] : WITHIN WHILE
    OVER C@ [CHAR] 0 - R> 10 * + >R
    1 /STRING
  REPEAT THEN
  R>
;
: WE-KLINE ( a u -- )
  WE-SKIP DUP 0= IF 2DROP EXIT THEN
  OVER C@ [CHAR] \ = IF 2DROP EXIT THEN
  WE-NUM >R
  WE-SKIP WE-NUM >R
  WE-SKIP
  DUP 0= IF 2DROP R> R> 2DROP EXIT THEN
  0 WE-TL !
  BEGIN DUP WHILE OVER C@ BL > WHILE
    WE-TL @ 28 < IF
      OVER C@ WE-UPC WE-TOK WE-TL @ + C!
      1 WE-TL +!
    THEN
    1 /STRING
  REPEAT THEN
  2DROP
  WE-TL @ 0= IF R> R> 2DROP EXIT THEN
  R> R>                         \ color action
  DUP 1 10 WITHIN 0= IF 2DROP EXIT THEN
  WE-KCNT @ WE-KMAX >= IF 2DROP EXIT THEN
  WE-KCNT @ WE-KREC WE-JA !
  WE-TL @ WE-JA @ C!
  WE-JA @ 1+ C!                \ action
  WE-JA @ 2 + C!               \ color
  WE-TOK WE-JA @ 3 + WE-TL @ CMOVE
  1 WE-KCNT +!
;
: WE-KLOAD ( -- )
  0 WE-KCNT !
  LIBRARY-PATH DUP 480 > IF 2DROP EXIT THEN
  WE-COLP SWAP DUP >R CMOVE
  S" /WinEd/WINED.COL" WE-COLP R@ + SWAP DUP >R CMOVE
  WE-COLP R> R> + R/O OPEN-FILE IF DROP EXIT THEN
  WE-FID !
  BEGIN
    WE-PBUF 240 WE-FID @ READ-LINE
    IF DROP 0 THEN
  WHILE
    WE-PBUF SWAP WE-KLINE
  REPEAT DROP
  WE-FID @ CLOSE-FILE DROP
  WE-KSORT
;
: WE-KFIND ( a u -- action color flag )
  28 MIN WE-FLEN !  WE-FADDR !
  0 WE-KLO !  WE-KCNT @ WE-KHI !
  BEGIN WE-KLO @ WE-KHI @ < WHILE
    WE-KLO @ WE-KHI @ + 2/ WE-MIDN !
    WE-FADDR @ WE-FLEN @
    WE-MIDN @ WE-KREC 3 +
    WE-MIDN @ WE-KREC C@
    COMPARE
    DUP 0= IF
      DROP
      WE-MIDN @ WE-KREC DUP 1+ C@ SWAP 2 + C@
      -1 EXIT
    THEN
    0< IF WE-MIDN @ WE-KHI ! ELSE WE-MIDN @ 1+ WE-KLO ! THEN
  REPEAT
  0
;

: WE-SOURCE? ( -- f )
  WE-NAME C@ 0= IF 0 EXIT THEN
  WE-NAME 1+ WE-UPBUF WE-NAME C@ 255 MIN CMOVE
  WE-NAME C@ 255 MIN WE-FLEN !
  WE-UPBUF WE-FLEN @ 0 DO DUP I + DUP C@ WE-UPC SWAP C! LOOP DROP
  WE-FLEN @ 2 >= IF
    WE-UPBUF WE-FLEN @ 2 - + 2 S" .F" COMPARE 0= IF -1 EXIT THEN
  THEN
  WE-FLEN @ 3 >= IF
    WE-UPBUF WE-FLEN @ 3 - + 3 S" .FS" COMPARE 0= IF -1 EXIT THEN
  THEN
  WE-FLEN @ 4 >= IF
    WE-UPBUF WE-FLEN @ 4 - + 4 S" .FTH" COMPARE 0= IF -1 EXIT THEN
    WE-UPBUF WE-FLEN @ 4 - + 4 S" .4TH" COMPARE 0= IF -1 EXIT THEN
  THEN
  0
;
: WE-PAPER ( n -- c8 )
  CASE
    0 OF 15 ENDOF
    1 OF 12 ENDOF
    2 OF 10 ENDOF
    3 OF 14 ENDOF
    4 OF 9 ENDOF
    5 OF 13 ENDOF
    6 OF 11 ENDOF
    7 OF 15 ENDOF
    8 OF 0 ENDOF
    9 OF 12 ENDOF
    10 OF 10 ENDOF
    11 OF 14 ENDOF
    12 OF 9 ENDOF
    13 OF 13 ENDOF
    14 OF 11 ENDOF
    15 OF 15 ENDOF
    DUP
  ENDCASE
;
\ Screen column is bcol minus the horizontal origin. Clip, then fill
\ that many character cells. Row 0 is the top of the window.
: WE-PAINT ( bcol n color -- )
  WE-PC ! WE-PN !
  WE-H0 @ - WE-PS !
  WE-PS @ 0< IF
    WE-PS @ NEGATE WE-PN @ SWAP - 0 MAX WE-PN !
    0 WE-PS !
  THEN
  WE-PS @ WE-PN @ + G-COLS > IF
    G-COLS WE-PS @ - 0 MAX WE-PN !
  THEN
  WE-PN @ 1 < IF EXIT THEN
  G-CELLH 0 DO
    WE-SR @ G-CELLH * I + G-PX *
    WE-PS @ G-CELLW * + G-PIX +
    WE-PN @ G-CELLW * WE-PC @ FILL
  LOOP
  -1 TO G-PDIRTY?
;

: WE-DELIM ( action -- c )
  DUP 3 = IF DROP [CHAR] ) EXIT THEN
  DUP 4 = IF DROP [CHAR] " EXIT THEN
  DUP 5 = IF DROP [CHAR] } EXIT THEN
  DUP 6 = IF DROP [CHAR] ] EXIT THEN
  DROP [CHAR] >
;
: WE-COLOR-ROW ( off srow -- )
  WE-SR !  DUP WE-NEXT-EOL WE-LE !  WE-L0 !  WE-L0 @ WE-POFF !
  0 WE-PAIR !
  BEGIN WE-POFF @ WE-LE @ < WHILE
    WE-POFF @ WE-AT C@ BL = IF
      1 WE-POFF +!
    ELSE
      WE-POFF @ WE-TSTART !
      0 WE-TL !  0 WE-TLEN !
      BEGIN WE-POFF @ WE-LE @ < WE-POFF @ WE-AT C@ BL <> AND WHILE
        WE-TL @ 28 < IF
          WE-POFF @ WE-AT C@ WE-UPC WE-TOK WE-TL @ + C!
          1 WE-TL +!
        THEN
        1 WE-TLEN +!  1 WE-POFF +!
      REPEAT
      WE-PAIR @ 2 = IF
        0 WE-PAIR !
      ELSE WE-PAIR @ 1 = IF
        WE-TSTART @ WE-L0 @ - WE-TLEN @ WE-ACOL @ WE-PAPER WE-PAINT
        0 WE-PAIR !
      ELSE
        WE-TOK WE-TL @ WE-KFIND IF
          WE-ACOL ! WE-ACT !
          WE-ACT @ 1 = WE-ACT @ 8 = OR WE-ACT @ 9 = OR IF
            WE-TSTART @ WE-L0 @ - WE-TLEN @ WE-ACOL @ WE-PAPER WE-PAINT
          THEN
          WE-ACT @ 8 = IF 2 WE-PAIR ! THEN
          WE-ACT @ 9 = IF 1 WE-PAIR ! THEN
          WE-ACT @ 2 = IF
            WE-TSTART @ WE-L0 @ - WE-LE @ WE-TSTART @ - WE-ACOL @ WE-PAPER WE-PAINT
            WE-LE @ WE-POFF !
          THEN
          WE-ACT @ 3 8 WITHIN IF
            WE-ACT @ WE-DELIM WE-ADEL !
            0 WE-SEEN !
            BEGIN WE-POFF @ WE-LE @ < WE-SEEN @ 0= AND WHILE
              WE-POFF @ WE-AT C@ WE-ADEL @ = IF
                1 WE-POFF +!  -1 WE-SEEN !
              ELSE
                1 WE-POFF +!
              THEN
            REPEAT
            WE-TSTART @ WE-L0 @ - WE-POFF @ WE-TSTART @ - WE-ACOL @ WE-PAPER WE-PAINT
          THEN
        ELSE
          DROP
        THEN
      THEN THEN
    THEN
  REPEAT
;

\ --- drawing ----------------------------------------------------------------

: WE-SAY ( row c-addr u -- )
  G-COLS MIN >R
  SWAP 0 SWAP AT
  R> TYPE
;
: WE-ADD ( c -- )
  WE-NW @ 200 < IF WE-UPBUF WE-NW @ + C! 1 WE-NW +! ELSE DROP THEN
;
: WE-ADDS ( a u -- )
  0 ?DO DUP C@ WE-ADD 1+ LOOP DROP
;
: WE-STATUS ( -- )
  0 WE-NW !
  WE-MODE @ 2 = IF
    WE-NAME C@ IF WE-NAME COUNT ELSE S" (untitled)" THEN
    G-COLS 24 - 4 MAX MIN WE-ADDS
    S"  S save  D discard  Esc" WE-ADDS
  ELSE WE-FINDON @ IF
    S" Find:" WE-ADDS
    WE-FIELD @ 0= IF [CHAR] _ WE-ADD THEN
    WE-FIND COUNT WE-ADDS
    WE-REPLON @ IF
      S"  Repl:" WE-ADDS
      WE-FIELD @ IF [CHAR] _ WE-ADD THEN
      WE-REPL COUNT WE-ADDS
    THEN
  ELSE
    WE-BROWSE @ IF S" Browse " WE-ADDS THEN
    WE-OVER @ IF S" Over " WE-ADDS THEN
    WE-DIRT @ IF [CHAR] * WE-ADD BL WE-ADD THEN
    WE-NAME C@ IF WE-NAME COUNT 80 MIN WE-ADDS
    ELSE S" (untitled)" WE-ADDS THEN
    WE-MSG C@ IF BL WE-ADD WE-MSG COUNT WE-ADDS THEN
  THEN THEN
  1 WE-UPBUF WE-NW @ WE-SAY
;
: WE-HELP ( -- )
  2 S" Command-N New    Command-O Open" WE-SAY
  3 S" Command-S Save   Shift-S Save As" WE-SAY
  4 S" Command-W Close  Command-F Find" WE-SAY
  5 S" Shift-F Replace  Command-G Next" WE-SAY
  6 S" Shift-G Previous. NEXT: 8 files." WE-SAY
  7 S" Command-A All    Command-C Copy" WE-SAY
  8 S" Command-X Cut    Command-V Paste" WE-SAY
  9 S" Command-Z Undo   Command-/ Comment" WE-SAY
  10 S" Shift-B Browse   Insert overstrike" WE-SAY
  11 S" Arrows move. Shift selects." WE-SAY
  12 S" Quit asks each dirty. Any key back." WE-SAY
;
: WE-PUT-LINE ( row off -- off' )
  SWAP WE-SR !
  DUP WE-NEXT-EOL WE-LE !
  DUP WE-L0 !
  WE-L0 @ WE-H0 @ + WE-CS !
  WE-LE @ WE-CS @ - 0 MAX G-COLS MIN WE-PN !
  0 WE-SR @ AT
  WE-PN @ IF WE-CS @ WE-AT WE-PN @ TYPE THEN
  G-COLS WE-PN @ - 0 MAX 0 ?DO BL EMIT LOOP
  DROP
  WE-LE @ WE-LEN @ < IF WE-LE @ 1+ ELSE WE-LE @ THEN
;
: WE-SEL-PAINT ( off srow -- )
  WE-SR ! WE-L0 !
  WE-HAS-SEL? 0= IF EXIT THEN
  WE-ANCH @ WE-CUR @ 2DUP > IF SWAP THEN WE-HI ! WE-LO !
  WE-L0 @ WE-NEXT-EOL WE-LE !
  WE-L0 @ WE-HI @ >= IF EXIT THEN
  WE-LE @ WE-LO @ <= IF EXIT THEN
  WE-L0 @ WE-LO @ MAX WE-CS !
  WE-LE @ WE-HI @ MIN WE-JB !
  WE-CS @ WE-L0 @ -
  WE-JB @ WE-CS @ -
  9 WE-PAINT
;
: WE-CARET ( -- )
  WE-CUR @ WE-LINE-START WE-L0 !
  -1 WE-SEEN !
  WE-TOP @
  WE-VROWS 0 DO
    DUP WE-L0 @ = IF I WE-SEEN ! LEAVE THEN
    WE-NEXT-LINE
  LOOP DROP
  WE-SEEN @ 0< IF EXIT THEN
  WE-SEEN @ WE-TEXT0 + WE-SR !
  WE-LINE-COL 1 0 WE-PAINT
;
: WE-REDRAW ( -- )
  G-PIX G-PIXBYTES CWHITE FILL
  G-BUF G-COLS G-ROWS * BL FILL
  0 G-CX !  0 G-CY !
  0 S" NEW OPEN SAVE CLOSE NEXT FIND HELP QUIT" WE-SAY
  WE-STATUS
  WE-MODE @ 1 = IF WE-HELP PREFRESH EXIT THEN
  WE-TOP @
  WE-VROWS 0 DO I WE-TEXT0 + SWAP WE-PUT-LINE LOOP DROP
  WE-SOURCE? IF
    WE-TOP @
    WE-VROWS 0 DO DUP I WE-TEXT0 + WE-COLOR-ROW WE-NEXT-LINE LOOP DROP
  THEN
  WE-TOP @
  WE-VROWS 0 DO DUP I WE-TEXT0 + WE-SEL-PAINT WE-NEXT-LINE LOOP DROP
  WE-MODE @ 0= IF WE-CARET THEN
  PREFRESH
;

\ --- keys: EditForth commands. Command and Control share bit 512. ----------

: WE-BASE ( -- n ) WE-K @ 255 AND ;
: WE-CH ( -- c ) WE-BASE WE-UPC ;
: WE-TAB ( -- ) BL WE-INS-CH BL WE-INS-CH ;
: WE-CHROME ( col -- )
  DUP 3 < IF DROP WE-DO-NEW EXIT THEN
  DUP 4 8 WITHIN IF DROP WE-DO-OPEN EXIT THEN
  DUP 9 13 WITHIN IF DROP WE-DO-SAVE EXIT THEN
  DUP 14 19 WITHIN IF DROP WE-DO-CLOSE EXIT THEN
  DUP 20 24 WITHIN IF DROP WE-NEXT-FILE EXIT THEN
  DUP 25 29 WITHIN IF DROP WE-FIND-OPEN EXIT THEN
  DUP 30 34 WITHIN IF DROP 1 WE-MODE ! EXIT THEN
  DUP 35 39 WITHIN IF DROP WE-ASK-QUIT EXIT THEN
  DROP
;
: WE-COMMAND ( -- )
  WE-BASE [CHAR] / = IF WE-COMMENT EXIT THEN
  WE-CH
  DUP [CHAR] N = IF DROP WE-DO-NEW EXIT THEN
  DUP [CHAR] O = IF DROP WE-DO-OPEN EXIT THEN
  DUP [CHAR] S = IF DROP
    WE-K @ WE-SHIFT AND IF WE-DO-SAVEAS ELSE WE-DO-SAVE THEN EXIT THEN
  DUP [CHAR] W = IF DROP WE-DO-CLOSE EXIT THEN
  DUP [CHAR] Q = IF DROP WE-ASK-QUIT EXIT THEN
  DUP [CHAR] F = IF DROP
    WE-K @ WE-SHIFT AND IF WE-FIND-REPL ELSE WE-FIND-OPEN THEN EXIT THEN
  DUP [CHAR] G = IF DROP
    WE-K @ WE-SHIFT AND IF WE-FIND-PREV ELSE WE-FIND-NEXT THEN EXIT THEN
  DUP [CHAR] A = IF DROP WE-SEL-ALL EXIT THEN
  DUP [CHAR] C = IF DROP WE-COPY DROP EXIT THEN
  DUP [CHAR] X = IF DROP WE-CUT EXIT THEN
  DUP [CHAR] V = IF DROP WE-PASTE EXIT THEN
  DUP [CHAR] Z = IF DROP WE-UNDO-DO EXIT THEN
  DUP [CHAR] B = IF DROP
    WE-K @ WE-SHIFT AND IF WE-BROWSE @ 0= WE-BROWSE ! THEN
    EXIT THEN
  DROP
;
\ 0 = not a motion. Command wins over Option.
: WE-MOVE-CODE ( -- n )
  WE-BASE WE-LEFTK = IF
    WE-K @ WE-CMD AND IF 5 EXIT THEN
    WE-K @ WE-OPT AND IF 11 EXIT THEN
    1 EXIT
  THEN
  WE-BASE WE-RIGHTK = IF
    WE-K @ WE-CMD AND IF 6 EXIT THEN
    WE-K @ WE-OPT AND IF 12 EXIT THEN
    2 EXIT
  THEN
  WE-BASE WE-UP = IF WE-K @ WE-CMD AND IF 7 EXIT THEN 3 EXIT THEN
  WE-BASE WE-DOWN = IF WE-K @ WE-CMD AND IF 8 EXIT THEN 4 EXIT THEN
  WE-BASE WE-HOME = IF 7 EXIT THEN
  WE-BASE WE-ENDK = IF 8 EXIT THEN
  WE-BASE WE-PGUP = IF
    WE-K @ WE-CMD AND IF 7 EXIT THEN
    WE-K @ WE-OPT AND IF 13 EXIT THEN
    9 EXIT
  THEN
  WE-BASE WE-PGDN = IF
    WE-K @ WE-CMD AND IF 8 EXIT THEN
    WE-K @ WE-OPT AND IF 14 EXIT THEN
    10 EXIT
  THEN
  0
;
: WE-DO-MOVE ( n -- )
  WE-K @ WE-SHIFT AND IF
    WE-ANCH @ 0< IF WE-CUR @ WE-ANCH ! THEN
  ELSE
    -1 WE-ANCH !
  THEN
  CASE
    1 OF WE-LEFT1 ENDOF
    2 OF WE-RIGHT1 ENDOF
    3 OF WE-UP1 ENDOF
    4 OF WE-DOWN1 ENDOF
    5 OF WE-HOME-LINE ENDOF
    6 OF WE-END-LINE ENDOF
    7 OF WE-DOC-HOME ENDOF
    8 OF WE-DOC-END ENDOF
    9 OF WE-VROWS NEGATE WE-PAGE ENDOF
    10 OF WE-VROWS WE-PAGE ENDOF
    11 OF WE-WORDL ENDOF
    12 OF WE-WORDR ENDOF
    13 OF -1 WE-BLANK-PAGE ENDOF
    14 OF 1 WE-BLANK-PAGE ENDOF
  ENDCASE
  WE-ENSURE
;
: WE-WHEEL ( -- f )
  WE-BASE WE-SCRUP = IF
    WE-TOP @ DUP 0= IF DROP ELSE WE-PREV-LINE WE-TOP ! THEN
    -1 EXIT
  THEN
  WE-BASE WE-SCRDN = IF
    WE-TOP @ WE-NEXT-LINE
    DUP WE-TOP @ = IF DROP -1 EXIT THEN
    DUP WE-LEN @ > IF DROP -1 EXIT THEN
    WE-TOP ! -1 EXIT
  THEN
  0
;
\ True when the find bar ate the key. Arrows and Command keys return false.
: WE-FIND-TRY ( c -- f )
  WE-FINDON @ 0= IF DROP 0 EXIT THEN
  DUP 27 = IF DROP 0 WE-FINDON ! 0 WE-REPLON ! -1 EXIT THEN
  DUP 255 AND 9 = IF
    DROP
    WE-REPLON @ IF
      WE-K @ WE-SHIFT AND IF 0 WE-FIELD !
      ELSE WE-FIELD @ 0= IF -1 ELSE 0 THEN WE-FIELD ! THEN
    THEN
    -1 EXIT
  THEN
  DUP 13 = OVER 10 = OR IF
    DROP
    WE-REPLON @ IF WE-REPLACE-ONE ELSE WE-FIND-NEXT THEN
    -1 EXIT
  THEN
  WE-K @ WE-CMD AND IF DROP 0 EXIT THEN
  DUP BL 127 WITHIN IF WE-FIELD-CH -1 EXIT THEN
  DUP 8 = OVER 127 = OR IF DROP WE-FIELD-BS -1 EXIT THEN
  DROP 0
;
: WE-DO-KEY ( c -- )
  WE-K !
  WE-MODE @ 1 = IF
    WE-K @ WE-CMD AND WE-BASE [CHAR] Q = AND IF WE-ASK-QUIT EXIT THEN
    0 WE-MODE ! EXIT
  THEN
  WE-MODE @ 2 = IF WE-K @ WE-CONFIRM-KEY EXIT THEN
  WE-K @ WE-FIND-TRY IF EXIT THEN
  WE-BASE 27 = IF WE-ASK-QUIT EXIT THEN
  WE-K @ WE-CMD AND IF WE-COMMAND EXIT THEN
  WE-MOVE-CODE ?DUP IF WE-DO-MOVE EXIT THEN
  WE-WHEEL IF EXIT THEN
  WE-K @ WE-OPT AND IF EXIT THEN
  WE-BASE DUP 8 = OVER 127 = OR IF DROP WE-BS EXIT THEN DROP
  WE-BASE WE-FDEL = IF WE-FDEL-DO EXIT THEN
  WE-BASE 13 = WE-BASE 10 = OR IF WE-NL EXIT THEN
  WE-BASE 9 = IF WE-TAB EXIT THEN
  WE-BASE WE-INSK = IF WE-OVER @ 0= WE-OVER ! EXIT THEN
  WE-BASE BL 127 WITHIN IF WE-BASE WE-INS-CH THEN
;
: WE-COL-OF ( x -- col ) G-CELLW / 0 MAX G-COLS 1- MIN ;
: WE-ROW-OF ( y -- row )
  G-PY 1- SWAP - G-CELLH / 0 MAX G-ROWS 1- MIN
;
: WE-MOUSE ( x y b -- f )
  WE-MODE @ 1 = IF
    \ The click that opened help is still down. Wait until it is
    \ released, then a later click leaves help.
    DUP IF
      WE-WASDOWN @ IF DROP 2DROP 0 EXIT THEN
      DROP 2DROP 0 WE-MODE ! -1 WE-WASDOWN ! -1
    ELSE
      DROP 2DROP 0 WE-WASDOWN ! 0
    THEN
    EXIT
  THEN
  WE-MODE @ 2 = IF DROP 2DROP 0 EXIT THEN
  DUP 1 <> IF DROP 2DROP 0 WE-WASDOWN ! 0 EXIT THEN
  DROP
  WE-WASDOWN @ IF 2DROP 0 EXIT THEN
  -1 WE-WASDOWN !
  SWAP WE-COL-OF WE-JB !
  WE-ROW-OF WE-SR !
  WE-SR @ 0= IF WE-JB @ WE-CHROME -1 EXIT THEN
  WE-SR @ 1 = IF 0 EXIT THEN
  WE-SR @ WE-TEXT0 - DUP 0< IF DROP 0 EXIT THEN
  WE-TOP @ SWAP 0 ?DO WE-NEXT-LINE LOOP
  WE-JB @ WE-H0 @ + WE-GOTO
  -1 WE-ANCH !
  WE-ENSURE
  -1
;

: WE-SYNC ( -- )
  ?WINDOW-RESIZE
  G-COLS WE-LCOLS @ = G-ROWS WE-LROWS @ = AND IF EXIT THEN
  G-COLS WE-LCOLS !
  G-ROWS WE-LROWS !
  WE-ENSURE
  WE-REDRAW
;
: WE-RUN ( -- )
  S" WINED64" APP-NAME
  WE-BOOT
  WE-KLOAD
  WINDOW PIXEL-ON COLOR8
  0 WE-LCOLS !  0 WE-LROWS !
  0 WE-DONE !  0 WE-WASDOWN !  0 WE-MODE !
  BEGIN WE-DONE @ 0= WHILE
    WE-SYNC
    (APP-PUMP)
    G-MOUSE WE-MOUSE IF WE-REDRAW THEN
    DEPTH IF BEGIN DEPTH WHILE DROP REPEAT THEN
    KEY? IF KEY WE-DO-KEY WE-REDRAW THEN
  REPEAT
  1BIT PIXEL-OFF
;

ONLY FORTH DEFINITIONS

: WE-BADN ( n -- ) CR ." WINED64 selftest failed " . CR ABORT ;

ONLY FORTH DEFINITIONS ALSO GRAPHICS

:CLASS WINED-EDITOR <SUPER OBJECT
  INT STARTED
  :M CLASSINIT: ( -- )
    CLASSINIT: SUPER
    0 TO STARTED
  ;M
  :M START: ( -- )
    STARTED IF EXIT THEN
    -1 TO STARTED
    WE-RUN
    0 TO STARTED
  ;M
;CLASS

WINED-EDITOR WINED-APP

\ Headless checks. Does not open the graphics window.
: WE-SELFTEST ( -- )
  WE-BOOT
  [CHAR] z WE-DO-KEY
  WE-LEN @ 1 <> IF 1 WE-BADN THEN
  [CHAR] z WE-CMD OR WE-DO-KEY
  WE-LEN @ IF 2 WE-BADN THEN
  [CHAR] a WE-DO-KEY
  0 WE-CUR !  -1 WE-ANCH !
  [CHAR] / WE-CMD OR WE-DO-KEY
  WE-LEN @ 3 <> IF 3 WE-BADN THEN
  WE-BODY C@ [CHAR] \ <> IF 4 WE-BADN THEN
  WE-BOOT
  [CHAR] a WE-INS-CH  [CHAR] b WE-INS-CH
  10 WE-INS-CH  [CHAR] c WE-INS-CH
  WE-LEN @ 4 <> IF 5 WE-BADN THEN
  0 WE-CUR !  -1 WE-ANCH !
  WE-COMMENT
  WE-LEN @ 6 <> IF 6 WE-BADN THEN
  WE-BODY C@ [CHAR] \ <> IF 7 WE-BADN THEN
  WE-COMMENT
  WE-LEN @ 4 <> IF 8 WE-BADN THEN
  S" b" WE-SETFIND
  0 WE-CUR !  -1 WE-ANCH !
  WE-FIND-NEXT
  WE-ANCH @ 1 <> IF 9 WE-BADN THEN
  WE-CUR @ 2 <> IF 10 WE-BADN THEN
  WE-KLOAD
  S" DUP" WE-KFIND 0= IF 11 WE-BADN THEN
  4 <> IF 12 WE-BADN THEN
  1 <> IF 13 WE-BADN THEN
  WE-KCNT @ 100 < IF 14 WE-BADN THEN
  WE-BOOT
  27 WE-DO-KEY
  WE-DONE @ 0= IF 15 WE-BADN THEN
  WE-BOOT
  -1 WE-FINDON !
  27 WE-DO-KEY
  WE-FINDON @ IF 16 WE-BADN THEN
  WE-DONE @ IF 17 WE-BADN THEN
  WE-BOOT
  30 WE-CHROME
  WE-MODE @ 1 <> IF 18 WE-BADN THEN
  0 WE-MODE !
  [CHAR] Q WE-CMD OR WE-DO-KEY
  WE-DONE @ 0= IF 19 WE-BADN THEN
  WE-BOOT
  1 WE-MODE !  -1 WE-WASDOWN !
  0 0 1 WE-MOUSE DROP
  WE-MODE @ 1 <> IF 20 WE-BADN THEN
  0 0 0 WE-MOUSE DROP
  WE-MODE @ 1 <> IF 21 WE-BADN THEN
  0 0 1 WE-MOUSE DROP
  WE-MODE @ IF 22 WE-BADN THEN
  WE-BOOT
  WE-NEXT-FILE
  WE-SLOT @ 1 <> IF 23 WE-BADN THEN
  WE-BOOT
  [CHAR] a WE-DO-KEY
  WE-NEXT-FILE
  [CHAR] b WE-DO-KEY
  [CHAR] Q WE-CMD OR WE-DO-KEY
  WE-MODE @ 2 <> IF 24 WE-BADN THEN
  WE-DONE @ IF 25 WE-BADN THEN
  [CHAR] d WE-DO-KEY
  WE-DONE @ IF 26 WE-BADN THEN
  WE-MODE @ 2 <> IF 27 WE-BADN THEN
  WE-SLOT @ IF 28 WE-BADN THEN
  [CHAR] d WE-DO-KEY
  WE-DONE @ 0= IF 29 WE-BADN THEN
  WE-BOOT
  [CHAR] a WE-DO-KEY
  WE-NEXT-FILE
  [CHAR] b WE-DO-KEY
  [CHAR] Q WE-CMD OR WE-DO-KEY
  27 WE-DO-KEY
  WE-DONE @ IF 30 WE-BADN THEN
  WE-MODE @ IF 31 WE-BADN THEN
  WE-DIRT @ 0= IF 32 WE-BADN THEN
  WE-BOOT
  S" /tmp/wined64-size.txt" DELETE-FILE DROP
  100 ALLOCATE IF DROP 33 WE-BADN THEN
  DUP 100 [CHAR] x FILL
  S" /tmp/wined64-size.txt" W/O CREATE-FILE IF
    DROP FREE DROP 33 WE-BADN
  THEN
  WE-FID !
  DUP 100 WE-FID @ WRITE-FILE IF
    WE-FID @ CLOSE-FILE DROP FREE DROP 34 WE-BADN
  THEN
  WE-FID @ CLOSE-FILE DROP
  FREE DROP
  S" /tmp/wined64-size.txt" WE-READ
  WE-LEN @ 100 <> IF 35 WE-BADN THEN
  WE-CAPA @ 4096 <> IF 36 WE-BADN THEN
  WE-PTR @ 0= IF 37 WE-BADN THEN
  WE-MSG C@ IF 38 WE-BADN THEN
  8192 WE-NEED 0= IF 39 WE-BADN THEN
  WE-CAPA @ 8192 < IF 40 WE-BADN THEN
  S" /tmp/wined64-size.txt" DELETE-FILE DROP
  3000 ALLOCATE IF DROP 41 WE-BADN THEN
  DUP 3000 [CHAR] y FILL
  S" /tmp/wined64-size.txt" W/O CREATE-FILE IF
    DROP FREE DROP 41 WE-BADN
  THEN
  WE-FID !
  DUP 3000 WE-FID @ WRITE-FILE IF
    WE-FID @ CLOSE-FILE DROP FREE DROP 42 WE-BADN
  THEN
  WE-FID @ CLOSE-FILE DROP
  FREE DROP
  S" /tmp/wined64-size.txt" WE-READ
  WE-LEN @ 3000 <> IF 43 WE-BADN THEN
  WE-CAPA @ 6000 <> IF 44 WE-BADN THEN
  WE-MSG C@ IF 45 WE-BADN THEN
  S" /tmp/wined64-empty.txt" DELETE-FILE DROP
  S" /tmp/wined64-empty.txt" W/O CREATE-FILE IF
    DROP 46 WE-BADN
  THEN
  WE-FID !
  WE-FID @ CLOSE-FILE DROP
  S" /tmp/wined64-empty.txt" WE-READ
  WE-LEN @ IF 47 WE-BADN THEN
  WE-CAPA @ 4096 <> IF 48 WE-BADN THEN
  S" /tmp/wined64-size.txt" DELETE-FILE DROP
  S" /tmp/wined64-empty.txt" DELETE-FILE DROP
  WE-BOOT
  WE-SAY-OK
;

\ EINED64 muct be last to work well with EditForth's development environment'
: WINED64 ( -- )
  START: WINED-APP
  WINDOW-OFF
;
